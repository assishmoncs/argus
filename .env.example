# ============================================================
# Argus Bot Configuration
# Copy this file to .env and fill in your values.
# ============================================================

# --- Required ---

# Your Telegram Bot token from @BotFather
TELEGRAM_TOKEN=your_telegram_bot_token_here

# Your Groq API key from Groq Console
# https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# --- Optional ---

# Limit bot to a specific group (0 = all groups)
GROUP_CHAT_ID=0

# Path to the SQLite database file
DATABASE_PATH=argus.db

# Directory for log files
LOG_DIR=logs

# AI Provider: groq | openai | anthropic (groq is default)
DEFAULT_AI_PROVIDER=groq

# Optional: OpenAI API key (for future OpenAI provider support)
# OPENAI_API_KEY=

# Optional: Anthropic API key (for future Anthropic provider support)
# ANTHROPIC_API_KEY=
