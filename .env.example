# ============================================================================
# Argus — Enterprise Telegram AI Moderation Bot Configuration (.env.example)
# ============================================================================

# Required Credentials
TELEGRAM_TOKEN=your_telegram_bot_token_here
GEMINI_API_KEY=your_gemini_api_key_here

# Core Scope & Environment
GROUP_CHAT_ID=0
ENVIRONMENT=production
DATABASE_PATH=warnings.db
LOG_DIR=logs
PLUGINS_DIR=plugins

# Logging & Telemetry
LOG_LEVEL=INFO
LOG_FORMAT=text
LOG_BACKUP_COUNT=7
ENABLE_TELEMETRY=true

# Database Connection Pool & Performance Tuning
DB_POOL_SIZE=5
DB_BUSY_TIMEOUT_MS=5000
DB_ENABLE_WAL=true
DB_CACHE_SIZE_KB=64000
DB_MAX_RETRIES=3
DB_RETRY_BASE_DELAY=0.05
DB_REPO_CACHE_TTL=30.0

# Gemini AI Integration, Caching & Circuit Breaker
GEMINI_MODEL=gemini-3.8-flash
GEMINI_FALLBACK_MODELS=gemini-3.5-flash-lite
AI_TIMEOUT_SECONDS=10.0
AI_MAX_RETRIES=2
AI_RETRY_BACKOFF_BASE=0.4
AI_CACHE_TTL_SECONDS=300.0
AI_CACHE_MAX_SIZE=1024
AI_CB_FAILURE_THRESHOLD=5
AI_CB_RECOVERY_SECONDS=30.0
AI_RATE_LIMIT_MAX_REQUESTS=10
AI_RATE_LIMIT_WINDOW_SECONDS=60.0
AI_GLOBAL_RATE_LIMIT_PER_MIN=120

# Concurrency & Bot Resilience
MAX_CONCURRENT_UPDATES=64
PER_CHAT_CONCURRENCY_LIMIT=8
TELEGRAM_API_RETRIES=3
TELEGRAM_API_RETRY_DELAY=0.5
SCHEDULER_INTERVAL_SECONDS=30.0
CAPTCHA_TIMEOUT_SECONDS=90
SHUTDOWN_TIMEOUT_SECONDS=10.0
ADMIN_CACHE_TTL_SECONDS=60.0
PLUGIN_LOAD_TIMEOUT_SECONDS=10.0
